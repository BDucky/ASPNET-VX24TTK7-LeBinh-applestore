@model AppleStore.Web.Models.HomeViewModel
@{
    ViewData["Title"] = "Home";
}

@* rauvang.com's homepage (live-browsed 2026-09-25): a rotating top banner,
   a promo banner, then a stack of full-width product banners, each one a
   link to that model's page. The 3D scene from the old hero stays behind
   the top banner, and the page keeps the site's dark gradient. *@

@if (Model.Carousel.Any())
{
    <section class="home-carousel" aria-roledescription="carousel" aria-label="Featured products" data-carousel>
        <div class="home-carousel-scene">
            <canvas id="hero-canvas" aria-hidden="true"></canvas>
        </div>
        @for (var i = 0; i < Model.Carousel.Count; i++)
        {
            var slide = Model.Carousel[i];
            var image = slide.ImageUrls.FirstOrDefault();
            <a class="home-slide @(i == 0 ? "is-active" : "")" asp-controller="Products" asp-action="Details" asp-route-slug="@slide.Slug"
               aria-roledescription="slide" aria-label="@(i + 1) of @Model.Carousel.Count: @slide.Name" aria-hidden="@(i == 0 ? "false" : "true")" tabindex="@(i == 0 ? 0 : -1)">
                <h2 class="home-slide-title">@slide.Name</h2>
                <p class="home-slide-tagline">@slide.Description</p>
                @if (image is not null)
                {
                    <span class="home-slide-media"><img src="@Url.Content(image)" alt="@slide.Name" /></span>
                }
            </a>
        }
        @if (Model.Carousel.Count > 1)
        {
            <button type="button" class="home-carousel-arrow is-prev" data-carousel-prev aria-label="Previous slide">&#8249;</button>
            <button type="button" class="home-carousel-arrow is-next" data-carousel-next aria-label="Next slide">&#8250;</button>
            <div class="home-carousel-dots">
                @for (var i = 0; i < Model.Carousel.Count; i++)
                {
                    <button type="button" class="home-carousel-dot @(i == 0 ? "is-active" : "")" data-carousel-dot="@i" aria-label="Go to slide @(i + 1)"></button>
                }
            </div>
        }
    </section>
}

<h1 class="visually-hidden">Apple Store</h1>

<div class="home-promo">
    <partial name="_PromoBanner" />
</div>

@foreach (var banner in Model.Banners)
{
    var image = banner.ImageUrls.FirstOrDefault();
    var fromPrice = banner.Variants.Select(v => v.Price).DefaultIfEmpty(0).Min();
    <a class="home-banner" asp-controller="Products" asp-action="Details" asp-route-slug="@banner.Slug">
        <h2 class="home-banner-title">@banner.Name</h2>
        <p class="home-banner-tagline">@banner.Description</p>
        @if (fromPrice > 0)
        {
            <span class="home-banner-price">From $@fromPrice.ToString("N2")</span>
        }
        @if (image is not null)
        {
            <span class="home-banner-media"><img src="@Url.Content(image)" alt="@banner.Name" loading="lazy" /></span>
        }
    </a>
}
