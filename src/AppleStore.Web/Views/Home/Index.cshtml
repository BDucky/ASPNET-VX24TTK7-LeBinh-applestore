@model AppleStore.Infrastructure.Services.ProductDetail?
@{
    ViewData["Title"] = "Home";
}

<section class="hero">
    <div class="container-fluid">
        <div class="hero-content">
            <div class="hero-eyebrow">Apple Store &middot; course project</div>
            <h1>EVERY DEVICE<br />ONE PLACE<br />YOU TRUST</h1>
            <p class="hero-sub">
                iPhone, Mac, iPad, Watch, and AirPods, genuine hardware, fast
                shipping, and support that actually answers.
            </p>
            <div class="hero-cta">
                <a href="#categories" class="btn-store-primary">Explore categories</a>
                <a href="#why" class="btn-store-ghost">Why Apple Store</a>
            </div>
        </div>
        <div class="hero-visual">
            <canvas id="hero-canvas" aria-hidden="true"></canvas>
        </div>
    </div>
</section>

<section class="statement" id="why">
    <div class="container-fluid">
        <p class="statement-text">
            <span class="word">Genuine</span> <span class="word">hardware,</span>
            <span class="word">fair</span> <span class="word">pricing,</span>
            <span class="word">fast</span> <span class="word">shipping,</span>
            <span class="word">and</span> <span class="word">support</span>
            <span class="word">that</span> <span class="word">actually</span>
            <span class="word">answers,</span> <span class="word">this</span>
            <span class="word">is</span> <span class="word">how</span>
            <span class="word">Apple</span> <span class="word">products</span>
            <span class="word">should</span> <span class="word">be</span>
            <span class="word">sold.</span>
        </p>
    </div>
</section>

<section class="statement" id="categories">
    <div class="container-fluid">
        <div class="category-grid">
            <a class="category-card" asp-controller="Products" asp-action="Index" asp-route-category="iphone">
                <div class="k">Phone</div>
                <h3>iPhone</h3>
                <p>Every current model and storage tier, verified stock only.</p>
            </a>
            <a class="category-card" asp-controller="Products" asp-action="Index" asp-route-category="mac">
                <div class="k">Computer</div>
                <h3>Mac</h3>
                <p>MacBook Air, MacBook Pro, and Mac mini.</p>
            </a>
            <a class="category-card" asp-controller="Products" asp-action="Index" asp-route-category="ipad">
                <div class="k">Tablet</div>
                <h3>iPad</h3>
                <p>iPad, iPad Air, and iPad Pro.</p>
            </a>
            <a class="category-card" asp-controller="Products" asp-action="Index" asp-route-category="watch">
                <div class="k">Wearable</div>
                <h3>Watch</h3>
                <p>Apple Watch Series, SE, and Ultra.</p>
            </a>
            <a class="category-card" asp-controller="Products" asp-action="Index" asp-route-category="accessories">
                <div class="k">Extras</div>
                <h3>Accessories</h3>
                <p>AirPods, HomePod mini, MagSafe, and more.</p>
            </a>
        </div>
    </div>
</section>

@if (Model is not null)
{
    <section class="statement is-compact" id="featured">
        <div class="container-fluid">
            <div class="hero-eyebrow">Just landed</div>
            <div class="featured-product">
                <div class="featured-media">
                    @{
                        var featuredImage = Model.ImageUrls.FirstOrDefault();
                    }
                    @if (featuredImage is not null)
                    {
                        <img src="@Url.Content(featuredImage)" alt="@Model.Name" />
                    }
                </div>
                <div class="featured-copy">
                    <h2>@Model.Name</h2>
                    <p>@Model.Description</p>
                    @{
                        var featuredPrice = Model.Variants.Select(v => v.Price).DefaultIfEmpty(0).Min();
                    }
                    <div class="price" style="font-size: 1.3rem; margin-bottom: 20px;">From $@featuredPrice.ToString("N2")</div>
                    <a asp-controller="Products" asp-action="Details" asp-route-slug="@Model.Slug" class="btn-store-primary">View @Model.Name</a>
                </div>
            </div>
        </div>
    </section>
}

<section class="statement is-compact">
    <div class="container-fluid">
        <div class="hero-eyebrow">Why Apple Store</div>
        <div class="feature-grid">
            <div class="feature-card">
                <h3>Verified stock only</h3>
                <p>Every listing reflects real, counted inventory, no orders placed against a product we don't actually have.</p>
            </div>
            <div class="feature-card">
                <h3>Fair, upfront pricing</h3>
                <p>The price on the card is the price at checkout. No surprise fees added at the last step.</p>
            </div>
            <div class="feature-card">
                <h3>Fast, tracked shipping</h3>
                <p>Every order ships with a tracking number and status updates, from confirmation to delivery.</p>
            </div>
            <div class="feature-card">
                <h3>Support that answers</h3>
                <p>Real people, reachable, who can actually resolve an order issue, not a chatbot loop.</p>
            </div>
        </div>
    </div>
</section>

<section class="usp-strip container-fluid">
    <div class="usp-tile">
        <div class="num" data-count-to="100" data-count-suffix="%">0%</div>
        <div class="label">Genuine products</div>
    </div>
    <div class="usp-tile">
        <div class="num" data-count-to="5">0</div>
        <div class="label">Product categories</div>
    </div>
    <div class="usp-tile">
        <div class="num" data-count-to="24" data-count-suffix="/7">0</div>
        <div class="label">Customer support</div>
    </div>
    <div class="usp-tile">
        <div class="num" data-count-to="30" data-count-suffix="-day">0</div>
        <div class="label">Returns window</div>
    </div>
</section>
