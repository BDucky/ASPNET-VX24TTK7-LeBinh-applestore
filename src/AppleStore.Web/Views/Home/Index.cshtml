@{
    ViewData["Title"] = "Home";
}

<section class="hero">
    <div class="container-fluid">
        <div class="hero-content">
            <div class="hero-eyebrow">Apple Store &middot; course project</div>
            <h1>EVERY DEVICE<br />ONE PLACE<br />YOU TRUST</h1>
            <p class="hero-sub">
                iPhone, Mac, iPad, Watch, and AirPods, genuine hardware, fast
                shipping, and support that actually answers.
            </p>
            <div class="hero-cta">
                <a href="#categories" class="btn-store-primary">Explore categories</a>
                <a href="#why" class="btn-store-ghost">Why Apple Store</a>
            </div>
        </div>
        <div class="hero-visual">
            <canvas id="hero-canvas" aria-hidden="true"></canvas>
        </div>
    </div>
</section>

<section class="statement" id="why">
    <div class="container-fluid">
        <p class="statement-text">
            <span class="word">Genuine</span> <span class="word">hardware,</span>
            <span class="word">fair</span> <span class="word">pricing,</span>
            <span class="word">fast</span> <span class="word">shipping,</span>
            <span class="word">and</span> <span class="word">support</span>
            <span class="word">that</span> <span class="word">actually</span>
            <span class="word">answers,</span> <span class="word">this</span>
            <span class="word">is</span> <span class="word">how</span>
            <span class="word">Apple</span> <span class="word">products</span>
            <span class="word">should</span> <span class="word">be</span>
            <span class="word">sold.</span>
        </p>
    </div>
</section>

<section class="statement" id="categories">
    <div class="container-fluid">
        <div class="category-grid">
            <div class="category-card">
                <div class="k">Phone</div>
                <h3>iPhone</h3>
                <p>Every current model and storage tier, verified stock only.</p>
            </div>
            <div class="category-card">
                <div class="k">Computer</div>
                <h3>Mac</h3>
                <p>MacBook Air, MacBook Pro, iMac, Mac mini, Mac Studio.</p>
            </div>
            <div class="category-card">
                <div class="k">Tablet</div>
                <h3>iPad</h3>
                <p>iPad, iPad Air, iPad Pro, and iPad mini, with accessories.</p>
            </div>
            <div class="category-card">
                <div class="k">Wearable</div>
                <h3>Watch</h3>
                <p>Apple Watch Series, SE, and Ultra, every band and case size.</p>
            </div>
        </div>
    </div>
</section>

<section class="usp-strip container-fluid">
    <div class="usp-tile">
        <div class="num" data-count-to="100" data-count-suffix="%">0%</div>
        <div class="label">Genuine products</div>
    </div>
    <div class="usp-tile">
        <div class="num" data-count-to="4">0</div>
        <div class="label">Product categories</div>
    </div>
    <div class="usp-tile">
        <div class="num" data-count-to="24" data-count-suffix="/7">0</div>
        <div class="label">Customer support</div>
    </div>
    <div class="usp-tile">
        <div class="num" data-count-to="30" data-count-suffix="-day">0</div>
        <div class="label">Returns window</div>
    </div>
</section>
