@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="statement is-compact">
    <div class="container-fluid">
        <div class="hero-eyebrow" style="color: #e0615a;">Error</div>
        <h1 style="font-size: clamp(1.8rem, 3.5vw, 2.6rem); margin-bottom: 6px;">Something went wrong</h1>
        <p style="max-width: 60ch; margin-bottom: 24px;">An error occurred while processing your request.</p>

        @if (Model.ShowRequestId)
        {
            <p style="margin-bottom: 24px;">
                <strong style="color: var(--text);">Request ID:</strong> <code>@Model.RequestId</code>
            </p>
        }

        <a asp-controller="Home" asp-action="Index" class="btn-store-primary">Back to home</a>

        <div style="margin-top: 40px; border-top: 1px solid var(--border); padding-top: 24px; max-width: 70ch;">
            <h3 style="font-size: 1.1rem; margin-bottom: 8px;">Development mode</h3>
            <p style="margin-bottom: 10px;">
                Swapping to <strong style="color: var(--text);">Development</strong> shows more detail about
                the error that occurred.
            </p>
            <p>
                <strong style="color: var(--text);">The Development environment shouldn't be enabled for
                deployed applications.</strong> It can expose sensitive information from exceptions to end
                users. For local debugging, set <strong style="color: var(--text);">ASPNETCORE_ENVIRONMENT</strong>
                to <strong style="color: var(--text);">Development</strong> and restart the app.
            </p>
        </div>
    </div>
</section>
