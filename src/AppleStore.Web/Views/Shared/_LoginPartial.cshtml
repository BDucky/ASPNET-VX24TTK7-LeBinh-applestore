@using AppleStore.Web.Models.Orders
@using AppleStore.Infrastructure.Identity
@using System.Security.Claims
@* Right side of the nav: sign-in link, or the signed-in user's name with
   their account page and a sign-out form (POST, so a link cannot sign
   anyone out). Staff also get a link to their pages (StaffLinks). The cart link
   comes first for everyone (a visitor following it is asked to sign in),
   then the compare link while the list holds something. *@
@if (User.Identity?.IsAuthenticated == true)
{
    var name = User.FindFirstValue(AppUserClaimsPrincipalFactory.FullNameClaim) ?? User.Identity.Name;
    <div class="site-nav-account">
        <vc:cart-count></vc:cart-count>
        <partial name="_CompareLink" />
        @if (StaffLinks.For(User) is { } staff)
        {
            <a class="site-nav-account-link" href="@staff.Href">@staff.Label</a>
        }
        <a class="site-nav-account-link" asp-area="" asp-controller="Account" asp-action="Index">@name</a>
        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="site-nav-account-out">Sign out</button>
        </form>
    </div>
}
else
{
    <div class="site-nav-account">
        <vc:cart-count></vc:cart-count>
        <partial name="_CompareLink" />
        <a class="site-nav-account-link" asp-area="" asp-controller="Account" asp-action="Login">Sign in</a>
    </div>
}
