@model AppleStore.Web.Models.Products.NoPhoto
@* Shown where a model has no licensed photo of that exact model yet (see
   setup/rauvang-sync/photos.json). A labelled line drawing of the kind of
   product (NoPhoto.For picks it from the category), so an empty well never
   looks like a broken image or like another product. *@
<span class="no-photo @Model.CssClass" role="img" aria-label="Photo coming soon" data-no-photo="@Model.Kind">
    <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        @switch (Model.Kind)
        {
            case "phone":
                <rect x="14" y="4" width="20" height="40" rx="5"></rect>
                <line x1="21" y1="9" x2="27" y2="9"></line>
                break;
            case "tablet":
                <rect x="8" y="5" width="32" height="38" rx="4"></rect>
                <circle cx="24" cy="38.5" r="1"></circle>
                break;
            case "laptop":
                <rect x="9" y="10" width="30" height="20" rx="2"></rect>
                <path d="M4 36h40l-3 4H7z"></path>
                break;
            case "watch":
                <rect x="13" y="13" width="22" height="22" rx="6"></rect>
                <path d="M17 13l2-8h10l2 8M17 35l2 8h10l2-8"></path>
                <line x1="35" y1="22" x2="37" y2="22"></line>
                break;
            case "earbuds":
                <path d="M16 8a6 6 0 0 1 6 6v6a6 6 0 0 1-6 6h-1v14"></path>
                <path d="M32 8a6 6 0 0 0-6 6v6a6 6 0 0 0 6 6h1v14"></path>
                break;
            case "tv":
                <rect x="5" y="8" width="38" height="24" rx="2"></rect>
                <line x1="18" y1="40" x2="30" y2="40"></line>
                <line x1="24" y1="32" x2="24" y2="40"></line>
                break;
            default:
                <rect x="10" y="8" width="28" height="34" rx="6"></rect>
                <circle cx="24" cy="25" r="7"></circle>
                <line x1="20" y1="4" x2="28" y2="4"></line>
                break;
        }
    </svg>
    <span class="no-photo-label">Photo coming soon</span>
</span>
