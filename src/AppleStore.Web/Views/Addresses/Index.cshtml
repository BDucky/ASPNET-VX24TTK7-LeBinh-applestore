@model IReadOnlyList<AppleStore.Domain.Entities.Address>
@{
    ViewData["Title"] = "Delivery addresses";
}

<section class="statement is-compact account-page">
    <div class="account-card is-wide">
        <div class="hero-eyebrow">Account</div>
        <h1 class="account-title">Delivery addresses</h1>

        @if (Model.Count == 0)
        {
            <p class="account-lead">You have no saved address yet. Add one to check out faster.</p>
        }
        else
        {
            <ul class="address-list">
                @foreach (var a in Model)
                {
                    <li class="address-item">
                        <div class="address-head">
                            <strong>@(a.Label ?? "Address")</strong>
                            @if (a.IsDefault)
                            {
                                <span class="address-badge">Default</span>
                            }
                        </div>
                        <p class="address-text">
                            @a.FullName, @a.Phone<br />
                            @string.Join(", ", new[] { a.AddressLine, a.Ward, a.District, a.City }.Where(p => !string.IsNullOrWhiteSpace(p)))
                        </p>
                        <div class="address-actions">
                            <a asp-action="Edit" asp-route-id="@a.Id">Edit</a>
                            @if (!a.IsDefault)
                            {
                                <form asp-action="SetDefault" asp-route-id="@a.Id" method="post">
                                    <button type="submit">Make default</button>
                                </form>
                            }
                            <form asp-action="Delete" asp-route-id="@a.Id" method="post">
                                <button type="submit" class="is-danger">Delete</button>
                            </form>
                        </div>
                    </li>
                }
            </ul>
        }

        <a asp-action="Create" class="btn-store-primary">Add an address</a>
        <p class="account-switch"><a asp-controller="Account" asp-action="Index">Back to my account</a></p>
    </div>
</section>
