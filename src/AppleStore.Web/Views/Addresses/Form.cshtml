@model AppleStore.Web.Models.Account.AddressViewModel
@{
    var id = ViewData["AddressId"] as int?;
    ViewData["Title"] = id is null ? "Add an address" : "Edit address";
}

<section class="statement is-compact account-page">
    <div class="account-card">
        <div class="hero-eyebrow">Account</div>
        <h1 class="account-title">@ViewData["Title"]</h1>

        <partial name="~/Views/Account/_AccountErrors.cshtml" />

        <form asp-action="@(id is null ? "Create" : "Edit")" asp-route-id="@id" method="post" class="account-form" novalidate>
            <label asp-for="Label"></label>
            <input asp-for="Label" />
            <span asp-validation-for="Label" class="account-field-error"></span>

            <partial name="_DeliveryFields" model="Model" />

            <label class="account-check">
                <input asp-for="IsDefault" />
                <span>@Html.DisplayNameFor(m => m.IsDefault)</span>
            </label>

            <button type="submit" class="btn-store-primary">Save address</button>
        </form>

        <p class="account-switch"><a asp-action="Index">Back to my addresses</a></p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
