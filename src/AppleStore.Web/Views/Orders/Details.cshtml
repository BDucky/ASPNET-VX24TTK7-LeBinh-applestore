@model AppleStore.Web.Models.Orders.OrderPage
@using AppleStore.Domain.Enums
@using AppleStore.Infrastructure.Formatting
@using AppleStore.Web.Models.Checkout
@using AppleStore.Web.Models.Orders
@using AppleStore.Infrastructure.Services
@{
    var order = Model.Order;
    ViewData["Title"] = $"Order #{order.Id}";
}

<section class="statement is-compact account-page">
    <div class="account-card is-full">
        <div class="hero-eyebrow">Order</div>
        <h1 class="account-title">Order #@order.Id</h1>
        <p class="account-lead">Placed @order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm"). @CheckoutMessages.Status(order.Status).</p>

        <partial name="_OrderSummary" model="order" />

        @if (order.PaymentMethod != PaymentMethod.Cod && order.PaymentStatus == OrderPaymentStatus.Unpaid && order.Status != OrderStatus.Cancelled)
        {
            <form asp-controller="Payments" asp-action="Pay" asp-route-orderId="@order.Id" method="post" class="order-pay">
                <button type="submit" class="btn-store-primary">Pay now</button>
            </form>
        }

        <div class="cart-actions">
            @if (Model.Actions.Contains(OrderAction.Cancel))
            {
                <form asp-controller="Orders" asp-action="Cancel" asp-route-id="@order.Id" method="post">
                    <button type="submit" class="btn-store-ghost">Cancel this order</button>
                </form>
            }
            <a class="btn-store-ghost" href="/Orders/@order.Id/Invoice" target="_blank" rel="noopener">Invoice</a>
            <a class="btn-store-ghost" asp-controller="Orders" asp-action="Index">My orders</a>
            <a class="btn-store-ghost" asp-controller="Products" asp-action="Index">Continue shopping</a>
        </div>
    </div>
</section>
