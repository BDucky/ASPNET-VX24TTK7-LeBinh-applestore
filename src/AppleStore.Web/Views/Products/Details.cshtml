@model AppleStore.Infrastructure.Services.ProductDetail
@{
    ViewData["Title"] = Model.Name;
}

<section class="statement is-compact">
    <div class="container-fluid">
        <div class="product-detail">
            <div class="product-detail-media">
                @{
                    var imageUrl = Model.ImageUrls.FirstOrDefault();
                }
                @if (imageUrl is not null)
                {
                    @* Manual cache-bust: the DB stores a plain path, so the Image
                       Tag Helper's asp-append-version can't apply here (it only
                       recognizes a literal ~/ src in markup, not a runtime value). *@
                    <img src="@Url.Content(imageUrl)?v=2" alt="@Model.Name" />
                }
            </div>
            <div>
                <div class="category-tag">@Model.CategoryName</div>
                <h1>@Model.Name</h1>
                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <p class="description">@Model.Description</p>
                }

                @if (Model.Variants.Any())
                {
                    <div class="variant-list">
                        @foreach (var variant in Model.Variants)
                        {
                            <a class="variant-row" asp-controller="Products" asp-action="Variant" asp-route-slug="@Model.Slug" asp-route-sku="@variant.SKU">
                                <div class="sku">@variant.SKU</div>
                                <div class="price">From $@variant.Price.ToString("N2")</div>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <p class="empty-state">This product is currently unavailable.</p>
                }

                <a href="@Url.Action("Index", "Products")" class="btn-store-ghost">Back to all products</a>
            </div>
        </div>
    </div>
</section>
