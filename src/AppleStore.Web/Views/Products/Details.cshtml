@model AppleStore.Infrastructure.Services.ProductDetail
@using AppleStore.Web.Models.Products
@{
    ViewData["Title"] = Model.Name;
    ViewData["NavCategory"] = Model.CategorySlug;
    var imageUrl = Model.ImageUrls.FirstOrDefault();
    var strip = ViewData[ModelStripViewModel.ViewDataKey] as ModelStripViewModel;
}

@* rauvang.com's model page (live-browsed 2026-09-25): the category's model
   strip, then one card per configuration (storage/size/region), each
   linking to its own page. No heading block, no description, no back button. *@
<section class="shop-page is-shop">
    @if (strip is not null)
    {
        <partial name="_ModelStrip" model="strip" />
    }
    <h1 class="visually-hidden">@Model.Name</h1>
    <partial name="_CompareButton" model="Model.Id" />

    @if (Model.Configurations.Any())
    {
        <div class="product-grid">
            @foreach (var config in Model.Configurations)
            {
                var card = new ShopCardViewModel(
                    Url.Action("Variant", "Products", new { slug = Model.Slug, config = config.Slug })!,
                    imageUrl,
                    config.Name,
                    config.InStock ? "In stock" : "Out of stock",
                    config.FromPrice);
                <partial name="_ShopCard" model="card" />
            }
        </div>
    }
    else
    {
        <p class="empty-state">This product is currently unavailable.</p>
    }
    <vc:product-reviews product-id="@Model.Id"></vc:product-reviews>
</section>
