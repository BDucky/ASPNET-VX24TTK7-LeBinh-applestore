@model AppleStore.Infrastructure.Services.ConfigurationDetail
@using System.Text.Json
@using AppleStore.Infrastructure.Formatting
@using AppleStore.Web.Models.Products
@{
    ViewData["Title"] = Model.Name;
    ViewData["NavCategory"] = Model.CategorySlug;
    var strip = ViewData[ModelStripViewModel.ViewDataKey] as ModelStripViewModel;
    var selected = Model.Select(Context.Request.Query["color"], Context.Request.Query["region"]);
    var colors = Model.Choices.Select(c => c.Color).OfType<string>().Distinct().ToList();
    var regions = Model.Choices.Select(c => c.Region).OfType<string>().Distinct().ToList();
    var choicesJson = JsonSerializer.Serialize(Model.Choices.Select(c => new
    {
        id = c.VariantId,
        buyable = c.Price is not null && c.StockQty > 0,
        sku = c.SKU,
        color = c.Color,
        region = c.Region,
        price = PriceText.Vnd(c.Price),
        stock = c.StockQty,
    }));
    var here = Context.Request.Path + Context.Request.QueryString;
    var selectedBuyable = selected.Price is not null && selected.StockQty > 0;
    string ChoiceUrl(string? color, string? region) =>
        Url.Action("Variant", "Products", new { slug = Model.ProductSlug, config = Model.Slug, color, region })!;
}

@* Laid out like rauvang.com's variant page (live-browsed 2026-09-25): model
   strip; photo left; on the right the configuration name, a red price with
   the warranty beside it, colour and region choices that change the price,
   labelled benefit and information blocks, one dark button.
   Colour chips are text, not photos: every model has one licensed photo,
   and rauvang's per-colour photos are its own property. Each chip is a real
   link, so choosing works without JavaScript; effects.js swaps the price in
   place when it runs. *@
<section class="shop-page is-shop">
    @if (strip is not null)
    {
        <partial name="_ModelStrip" model="strip" />
    }

    <div class="product-detail" data-config-choices="@choicesJson">
        <div class="product-detail-media">
            @if (Model.ImageUrl is not null)
            {
                <img src="@Url.Content(Model.ImageUrl)" alt="@Model.ProductName" />
            }
            else
            {
                <partial name="_NoPhoto" model="(string?)null" />
            }
        </div>
        <div class="product-detail-info">
            <h1>@Model.Name</h1>

            <div class="pdp-price-row">
                <span class="pdp-price-label">Price</span>
                <span class="pdp-price" data-choice-price>@PriceText.Vnd(selected.Price)</span>
                <span class="pdp-warranty">Warranty: <span>12 months, 1-for-1 on defects</span></span>
            </div>

            @if (colors.Any())
            {
                <div class="pdp-options" role="group" aria-label="Colour">
                    @foreach (var color in colors)
                    {
                        var isSelected = color == selected.Color;
                        <a class="pdp-chip @(isSelected ? "is-selected" : "")" href="@ChoiceUrl(color, selected.Region)"
                           data-choice-color="@color" aria-current="@(isSelected ? "true" : null)">@color</a>
                    }
                </div>
            }

            @if (regions.Any())
            {
                <div class="pdp-options-label">Region</div>
                <div class="pdp-options" role="group" aria-label="Region">
                    @foreach (var region in regions)
                    {
                        var isSelected = region == selected.Region;
                        var available = Model.Choices.Any(c => c.Color == selected.Color && c.Region == region);
                        <a class="pdp-chip is-small @(isSelected ? "is-selected" : "") @(available ? "" : "is-unavailable")" href="@ChoiceUrl(selected.Color, region)"
                           data-choice-region="@region" aria-current="@(isSelected ? "true" : null)">@region</a>
                    }
                </div>
            }

            @* The cart needs an account (decided 2026-10-07): a visitor gets a
               sign-in link that comes back to this exact choice. effects.js
               keeps the variant id, the return address and the button in
               step with the chips. *@
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form class="pdp-buy" asp-controller="Cart" asp-action="Add" method="post">
                    <input type="hidden" name="VariantId" value="@selected.VariantId" data-choice-variant />
                    <input type="hidden" name="Quantity" value="1" />
                    <input type="hidden" name="ReturnUrl" value="@here" data-choice-return />
                    <button type="submit" class="btn-store-primary" data-choice-buy disabled="@(!selectedBuyable)">Add to cart</button>
                </form>
            }
            else
            {
                <div class="pdp-buy">
                    <a class="btn-store-primary" href="/Account/Login?returnUrl=@Uri.EscapeDataString(here)" data-choice-signin>Sign in to add to cart</a>
                </div>
            }

            <div class="pdp-block">
                <div class="pdp-block-label">Store benefits</div>
                <ul>
                    <li><strong>12-month warranty</strong>, 1-for-1 replacement on hardware defects.</li>
                    <li><strong>30-day</strong> return window.</li>
                    <li><strong>Free</strong> standard shipping.</li>
                    <li>Pay by <strong>COD, VNPay, or MoMo</strong>.</li>
                </ul>
            </div>

            <div class="pdp-block">
                <div class="pdp-block-label">Product information</div>
                <ul>
                    <li>Model: @Model.ProductName</li>
                    <li>SKU: <span class="pdp-sku" data-choice-sku>@selected.SKU</span></li>
                    <li>
                        Availability:
                        <span class="pdp-stock @(selected.StockQty > 0 ? "is-in-stock" : "is-out-of-stock")" data-choice-stock>
                            @(selected.StockQty > 0 ? $"{selected.StockQty} in stock" : "Out of stock")
                        </span>
                    </li>
                </ul>
            </div>

            <a asp-controller="Products" asp-action="Details" asp-route-slug="@Model.ProductSlug" class="btn-store-dark">All @Model.ProductName options &raquo;</a>
        </div>
    </div>
    <vc:product-reviews product-id="@Model.ProductId"></vc:product-reviews>
</section>
