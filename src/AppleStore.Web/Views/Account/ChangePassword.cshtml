@model AppleStore.Web.Models.Account.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change password";
}

<section class="statement is-compact account-page">
    <div class="account-card">
        <div class="hero-eyebrow">Account</div>
        <h1 class="account-title">Change password</h1>
        <p class="account-lead">Other devices signed in to this account will be signed out.</p>

        <partial name="_AccountErrors" />

        <form asp-action="ChangePassword" method="post" class="account-form" novalidate>
            <label asp-for="CurrentPassword"></label>
            <input asp-for="CurrentPassword" autocomplete="current-password" />
            <span asp-validation-for="CurrentPassword" class="account-field-error"></span>

            <label asp-for="NewPassword"></label>
            <input asp-for="NewPassword" autocomplete="new-password" aria-describedby="password-hint" />
            <small id="password-hint" class="account-hint">At least 8 characters.</small>
            <span asp-validation-for="NewPassword" class="account-field-error"></span>

            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="account-field-error"></span>

            <button type="submit" class="btn-store-primary">Change password</button>
        </form>

        <p class="account-switch"><a asp-action="Index">Back to my account</a></p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
