@model AppleStore.Web.Models.Account.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
}

<section class="statement is-compact account-page">
    <div class="account-card">
        <div class="hero-eyebrow">Account</div>
        <h1 class="account-title">Choose a new password</h1>
        <p class="account-lead">
            Enter the code we sent to <strong>@Model.Email</strong> and your new password.
            The code is valid for 5 minutes.
        </p>

        <partial name="_AccountErrors" />

        <form asp-action="ResetPassword" method="post" class="account-form" novalidate>
            <input asp-for="Email" type="hidden" />

            <label asp-for="Code"></label>
            <input asp-for="Code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" class="account-otp" />
            <span asp-validation-for="Code" class="account-field-error"></span>

            <label asp-for="NewPassword"></label>
            <input asp-for="NewPassword" autocomplete="new-password" aria-describedby="password-hint" />
            <small id="password-hint" class="account-hint">At least 8 characters.</small>
            <span asp-validation-for="NewPassword" class="account-field-error"></span>

            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="account-field-error"></span>

            <button type="submit" class="btn-store-primary">Set new password</button>
        </form>

        <p class="account-switch">
            No code, or it expired? <a asp-action="ForgotPassword" asp-route-email="@Model.Email">Send a new code</a>.
        </p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
