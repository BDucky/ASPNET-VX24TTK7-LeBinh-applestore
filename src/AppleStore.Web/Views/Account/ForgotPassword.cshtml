@model AppleStore.Web.Models.Account.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
}

<section class="statement is-compact account-page">
    <div class="account-card">
        <div class="hero-eyebrow">Account</div>
        <h1 class="account-title">Forgot your password?</h1>
        <p class="account-lead">Enter your account's email and we will send you a 6-digit code.</p>

        <partial name="_AccountErrors" />

        <form asp-action="ForgotPassword" method="post" class="account-form" novalidate>
            <label asp-for="Email"></label>
            <input asp-for="Email" autocomplete="email" />
            <span asp-validation-for="Email" class="account-field-error"></span>

            <button type="submit" class="btn-store-primary">Send code</button>
        </form>

        <p class="account-switch">
            Remembered it? <a asp-action="Login">Sign in</a>.
            No account yet? <a asp-action="Register">Create one</a>.
        </p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
