@model IReadOnlyList<AppleStore.Infrastructure.Services.ReviewView>
@{
    ViewData["Title"] = "Reviews";
}

<section class="statement is-compact account-page">
    <div class="account-card is-full">
        <div class="hero-eyebrow">Staff</div>
        <h1 class="account-title">Reviews</h1>
        <partial name="_AdminNav" />

        @if (Model.Count == 0)
        {
            <p class="account-lead">No reviews yet.</p>
        }
        <ul class="admin-variants">
            @foreach (var r in Model)
            {
                <li class="admin-review">
                    <div class="admin-variant-name">
                        <strong>@r.ProductName · @r.Rating/5 · @r.Author</strong>
                        <span class="account-hint">@r.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm") · @(r.Visible ? "shown" : "hidden")</span>
                        @if (r.Content is not null)
                        {
                            <span>@r.Content</span>
                        }
                    </div>
                    <form asp-action="Reply" asp-route-id="@r.Id" method="post" class="admin-variant-form">
                        <label class="visually-hidden" for="reply-@r.Id">Reply</label>
                        <input id="reply-@r.Id" name="Reply" value="@r.Reply" placeholder="Reply as Apple Store" />
                        <button type="submit" class="btn-store-ghost">Save reply</button>
                    </form>
                    <form asp-action="@(r.Visible ? "Hide" : "Show")" asp-route-id="@r.Id" method="post">
                        <button type="submit" class="btn-store-ghost">@(r.Visible ? "Hide" : "Show")</button>
                    </form>
                </li>
            }
        </ul>
    </div>
</section>
