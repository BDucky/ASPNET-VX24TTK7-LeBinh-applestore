@model AppleStore.Web.Models.Admin.ReportPage
@{
    ViewData["Title"] = "Sales report";
    var range = $"from={Model.From:yyyy-MM-dd}&to={Model.To:yyyy-MM-dd}";
}

<section class="statement is-compact account-page">
    <div class="account-card is-full">
        <div class="hero-eyebrow">Staff</div>
        <h1 class="account-title">Sales report</h1>
        <partial name="_AdminNav" />

        <form method="get" class="admin-search report-range">
            <label for="from">From</label>
            <input id="from" name="from" type="date" value="@Model.From.ToString("yyyy-MM-dd")" />
            <label for="to">To</label>
            <input id="to" name="to" type="date" value="@Model.To.ToString("yyyy-MM-dd")" />
            <button type="submit" class="btn-store-ghost">Show</button>
        </form>

        @if (Model.Error is not null)
        {
            <p class="account-error" role="alert">@Model.Error</p>
        }
        @if (Model.Report is not null)
        {
            <div class="cart-actions">
                <a class="btn-store-primary" href="/Admin/Reports/Export?@range">Download Excel</a>
                <a class="btn-store-ghost" href="/Admin/Reports/Print?@range" target="_blank" rel="noopener">Print or save as PDF</a>
            </div>
            <partial name="_SalesReportTables" model="Model.Report" />
        }
    </div>
</section>
