@using AppleStore.Domain.Enums
@* Links between staff pages. Orders, reports, reviews, promotions and prices
   are for every staff role; the rest for admins (agreed 2026-10-08;
   promotions and prices 2026-10-09, the report gives them to employees too). *@
@{
    var current = ViewContext.RouteData.Values["controller"] as string;
    var isAdmin = User.IsInRole(nameof(UserRole.Admin));
    var links = new (string Controller, string Label, bool Shown)[]
    {
        ("Dashboard", "Dashboard", isAdmin),
        ("Orders", "Orders", true),
        ("Reports", "Reports", true),
        ("Reviews", "Reviews", true),
        ("Promotions", "Promotions", true),
        ("Prices", "Prices", true),
        ("Products", "Products", isAdmin),
        ("Vouchers", "Vouchers", isAdmin),
        ("Users", "Accounts", isAdmin),
    };
}
<nav class="admin-nav" aria-label="Admin">
    @foreach (var link in links.Where(l => l.Shown))
    {
        <a asp-area="Admin" asp-controller="@link.Controller" asp-action="Index"
           class="@(current == link.Controller ? "is-active" : "")" aria-current="@(current == link.Controller ? "page" : null)">@link.Label</a>
    }
    <a asp-area="" asp-controller="Home" asp-action="Index">Back to the store</a>
</nav>
