@* Links between admin pages. Later tasks add products, orders, vouchers
   and reports here as each page exists. *@
@{
    var current = ViewContext.RouteData.Values["controller"] as string;
}
<nav class="admin-nav" aria-label="Admin">
    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
       class="@(current == "Dashboard" ? "is-active" : "")" aria-current="@(current == "Dashboard" ? "page" : null)">Dashboard</a>
    <a asp-area="" asp-controller="Home" asp-action="Index">Back to the store</a>
</nav>
