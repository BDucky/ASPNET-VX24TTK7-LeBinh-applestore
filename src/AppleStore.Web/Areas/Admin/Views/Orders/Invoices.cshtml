@model IReadOnlyList<AppleStore.Infrastructure.Services.OrderSummary>
@* BM_INVOICE_01: several invoices printed at once, one per sheet. *@
@{
    Layout = "/Views/Shared/_PrintLayout.cshtml";
    ViewData["Title"] = "Invoices";
}

@if (Model.Count == 0)
{
    <p>Pick at least one order to print.</p>
}
@foreach (var order in Model)
{
    <partial name="_InvoiceBody" model="order" />
}
